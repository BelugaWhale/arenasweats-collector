[Unit]
Description=ArenaSweats collector ingest (receives Arena matches from collectors)
After=network.target

[Service]
User=admin-website-vps1
Group=admin-website-vps1
WorkingDirectory=/home/admin-website-vps1/arenasweats-collector/server
Environment=INGEST_DB=/home/admin-website-vps1/arenasweats-collector-data/ingest.db
ExecStart=/home/admin-website-vps1/arenasweats-collector-venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8870 --timeout 60 ingest:app
Restart=always
RestartSec=5
# Fenced in so it can never take memory or CPU from the website.
MemoryMax=600M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin-website-vps1/arenasweats-collector-data

[Install]
WantedBy=multi-user.target
